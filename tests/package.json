{
  "name": "synthex-tests",
  "version": "0.1.0",
  "private": true,
  "description": "Automated testing framework for Synthex agents and commands",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:schemas": "vitest run schemas/",
    "test:behavioral": "promptfoo eval --config promptfoo.config.yaml --filter-pattern 'B[0-9]'",
    "test:semantic": "promptfoo eval --config promptfoo.config.yaml",
    "test:all": "npm run test:schemas && npm run test:behavioral",
    "test:compat:contract": "vitest run schemas/cross-harness-compat.test.ts",
    "test:compat:offline": "node compat/scripts/run-suite.mjs --harness all",
    "test:compat:activation": "node compat/scripts/run-suite.mjs --profile activation --harness all",
    "test:compat:oldest": "node compat/scripts/run-suite.mjs --version-lane oldest --harness all",
    "test:compat:latest": "node compat/scripts/run-suite.mjs --version-lane latest --harness all",
    "test:compat:activation:claude": "node compat/scripts/run-suite.mjs --profile activation --harness claude",
    "test:compat:activation:codex": "node compat/scripts/run-suite.mjs --profile activation --harness codex",
    "test:compat:activation:gemini": "node compat/scripts/run-suite.mjs --profile activation --harness gemini",
    "test:compat:activation:opencode": "node compat/scripts/run-suite.mjs --profile activation --harness opencode",
    "snapshots:generate": "node helpers/generate-snapshots.js",
    "snapshots:update": "node helpers/generate-snapshots.js --update",
    "cache:clear": "rm -rf .cache/"
  },
  "devDependencies": {
    "vitest": "^4.0.16",
    "promptfoo": "^0.120.24",
    "typescript": "^5.9.3"
  }
}
